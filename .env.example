# Copie para .env. Em produção, os marcados com * são obrigatórios.
NODE_ENV=development
DATABASE_URL=postgres://vekrom:vekrom@localhost:5432/vekrom   # *
REDIS_URL=redis://localhost:6379                              # *
JWT_SECRET=troque-por-32-ou-mais-caracteres-aleatorios        # * openssl rand -hex 32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:5173                             # * domínio do web (vírgula separa vários)
PUBLIC_UPLOAD_URL=http://localhost:3001/files                 # * produção: https://SEU_DOMINIO/api/files
UPLOAD_DIR=./uploads                                          # produção: /home/vekrom/uploads
UPLOAD_MAX_BYTES=8388608
PGPOOL_MAX=5
API_PORT=3001
GATEWAY_PORT=3002
# TURN (voz atrás de NAT). Vazio = só STUN.
TURN_URLS=
TURN_SECRET=

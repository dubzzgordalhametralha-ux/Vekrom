{
  "name": "vekrom",
  "version": "0.1.0",
  "private": true,
  "description": "Vekrom \u2014 comunidade, jogos e conversas",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @vekrom/api dev",
    "dev:gateway": "pnpm --filter @vekrom/gateway dev",
    "dev:web": "pnpm --filter @vekrom/web dev",
    "dev:media": "pnpm --filter @vekrom/media dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @vekrom/api build",
    "build:gateway": "pnpm --filter @vekrom/gateway build",
    "build:web": "pnpm --filter @vekrom/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @vekrom/api db:migrate",
    "db:seed": "pnpm --filter @vekrom/api db:seed",
    "db:migrate:status": "pnpm --filter @vekrom/api db:migrate status",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "./scripts/deploy.sh",
    "backup": "./scripts/backup.sh"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
